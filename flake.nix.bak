{
  description = "Charlie's Tony Snowflake System - Minimal Base";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-unstable";
    # 引入 openclaw 來源
    openclaw.url = "github:openclaw/nix-openclaw";
    # COSMIC 桌面环境
    nixos-cosmic.url = "github:lilyinstarlight/nixos-cosmic";
  };

  outputs = { self, nixpkgs, openclaw, nixos-cosmic, ... }@inputs: {
    nixosConfigurations.charlie = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      specialArgs = { inherit inputs; }; # 確保傳遞 inputs 給 configuration.nix
      modules = [
        ./configuration.nix
        {
          nix.settings = {
            substituters = [ "https://cosmic.cachix.org" ];
            trusted-public-keys = [ "cosmic.cachix.org-1:Dya9IyXD4HwqkHRG02q1PEnwEKfPByjV+G3eTEfkwEo=" ];
          };
        }
        nixos-cosmic.nixosModules.default
      ];
    };
  };
}
