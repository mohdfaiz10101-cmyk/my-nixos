# NixOS 用户私密配置模板
# 使用方法：cp user-secrets.nix.example user-secrets.nix
# 然后编辑 user-secrets.nix 填入你自己的值
#
# 生成密码哈希：
#   nix-shell -p mkpasswd --run 'mkpasswd -m sha-512 你的密码'
#
# 代理订阅 URL：
#   向代理服务商获取订阅链接，末尾需加 &flag=meta（mihomo 格式）
{
  password = "$6$替换为你的密码哈希";
  subscriptionUrl = "https://你的订阅链接?flag=meta";
}
