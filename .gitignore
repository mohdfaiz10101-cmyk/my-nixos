# 硬件差异隔离（这是共享系统的关键）
hardware-configuration.nix

# 结果链接隔离
result
result-*

# 敏感文件隔离（secrets.nix 已迁移到 sops-nix 加密方案）
secrets.nix
# secrets/ 目录下的 .yaml 已加密（sops-nix），可以安全 git 追踪
# 但排除其他可能的明文临时文件
secrets/*.plaintext
secrets/*.tmp
.envrc
.envrc.bak
.envrc.save

# 临时文件隔离
*.swp
*~
.DS_Store
.idea/
.claude/
user-secrets.nix

# 测试脚本（含 API token）
claude-*.js
claude-*.py
claude_*.py

# Git 凭证
.git-credentials
tmp/

# Node modules（不应该被跟踪）
node_modules/

# 杂项
1
